# ---------------------------------------------------------------------------
# Trend Intelligence Engine — environment variables
# Copy to `.env` for local runs, or set each as a GitHub Actions secret.
# The pipeline runs in DRY-RUN mode for any source whose key is missing,
# emitting sample signals so the whole loop is testable without credentials.
# NOTE: every variable read anywhere in the code MUST be listed here.
#       scripts/audit_static.py enforces this.
# ---------------------------------------------------------------------------

# Reasoning layer
ANTHROPIC_API_KEY=

# Search + AI-visibility (Ahrefs)
AHREFS_API_KEY=

# Google Search Console (path to a service-account json, or a token)
GSC_CREDENTIALS=

# Google Trends / SerpApi (optional provider key)
SERPAPI_KEY=

# Social listening
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# News / PR
NEWS_API_KEY=

# Delivery — Airtable (trend + brief board)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Delivery — Slack (alerts + approvals)
SLACK_TOKEN=
SLACK_CHANNEL=
